int sensor = 7;  
int led = 6; 
int movimento;

void setup() {
  pinMode(sensor, INPUT);
  pinMode(led, OUTPUT);
}

void loop() {
  movimento = digitalRead(sensor);
  if (movimento == HIGH) {
    digitalWrite(led, HIGH);
    delay (5000);
  } else {
    digitalWrite(led, LOW);
    
  }
}
